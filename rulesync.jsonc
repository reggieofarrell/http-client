{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",

  // Single source of truth for AI agent instruction files lives in `.rulesync/rules/*.md` and
  // `.rulesync/skills/*/SKILL.md`. Edit those, then run `npm run rules:sync` to regenerate the
  // tool-native files below. `npm run rules:check` (rulesync generate --check) fails if the
  // generated files are stale; it runs in the pre-push hook and PR CI. Generated outputs are
  // never touched by prettier/eslint (see check:format/lint) and must not be hand-edited.
  //
  // rulesync docs: https://github.com/dyoshikawa/rulesync
  //
  // Generated per target (do not hand-edit):
  //   cursor     -> .cursor/rules/*.mdc, .cursor/skills/*/SKILL.md, .cursor/hooks.json
  //   claudecode -> CLAUDE.md (root), .claude/rules/*.md, .claude/skills/*/SKILL.md,
  //                 .claude/settings.json (hooks)
  //   agentsmd   -> AGENTS.md (root) + .agents/memories/*.md
  //   codexcli   -> AGENTS.md (root, shared with agentsmd) + .agents/skills/*/SKILL.md
  //                 + .codex/hooks.json
  //
  // The root rule (.rulesync/rules/overview.md) deliberately does not target `cursor` — Cursor
  // reads AGENTS.md natively, so emitting the root there too would load it twice.
  //
  // Skills, not commands: Codex CLI only supports rulesync "commands" in global mode (not
  // project mode) but has full project-mode "skills" support, and Cursor/Claude Code support
  // skills just as well as commands — so skills is the one instruction feature that reaches all
  // three targets. Hooks are generated separately from `.rulesync/hooks.jsonc`. See
  // `.rulesync/skills/*/SKILL.md`.
  "targets": ["cursor", "claudecode", "agentsmd", "codexcli"],
  "features": ["rules", "skills", "hooks"],

  // Shared Casadega policy and workflows travel with the exact executable
  // tooling release. Local http-client sources retain ownership of package-
  // specific architecture, testing details, and agent-hook configuration.
  "sources": [
    {
      "source": "@casadega-development/ts-repo-tooling",
      "transport": "npm",
      "registry": "https://npm.pkg.github.com",
      "ref": "0.7.0",
      "tokenEnv": "NODE_AUTH_TOKEN",
      "rules": [
        "casadega-code-documentation",
        "casadega-coding-fundamentals",
        "casadega-dead-code-policy",
        "casadega-public-api-documentation",
        "casadega-quality-gates",
        "casadega-rulesync-managed-config",
        "casadega-sonarqube-safety",
        "casadega-source-verified-working-mode",
        "casadega-test-falsification",
        "casadega-testing-documentation-sync",
        "casadega-testing-quality",
        "casadega-typescript-quality",
      ],
      "skills": [
        "casadega-dependency-upgrade",
        "casadega-fix-sonarqube-issues",
        "casadega-implementation-planning",
        "casadega-implementation-review",
        "casadega-maintain-public-api",
        "casadega-plan-execution",
        "casadega-release-npm-library",
        "casadega-review-rules-compliance",
        "casadega-rulesync-upgrade-review",
        "casadega-sync-dual-readmes",
        "casadega-unit-testing",
      ],
    },
  ],
}
