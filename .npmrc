# Supply-chain cooldown (npm 11.10+). Rejects package versions published fewer than
# this many days ago so a compromised publish can be yanked before we resolve it
# (most malicious versions are taken down the same day; one day is the buffer).
# Unit is days (a Number).
#
# npm < 11.10 silently ignores this key. .nvmrc pins a Node version whose bundled
# npm satisfies this floor; scripts/check-node-version.sh enforces that locally.
min-release-age=1
