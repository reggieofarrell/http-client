# Supply-chain cooldown (npm 11.10+). Rejects package versions published fewer than
# this many days ago so a compromised publish can be yanked before we resolve it
# (most malicious versions are taken down the same day; one day is the buffer).
# Unit is days (a Number).
#
# npm < 11.10 silently ignores this key. .nvmrc pins a Node version whose bundled
# npm satisfies this floor; scripts/check-node-version.sh enforces that locally.
min-release-age=1

# Resolve Casadega's private shared development tooling from GitHub Packages.
# Authentication remains outside the repository: developers use user-level npm
# credentials, while GitHub Actions injects a read-only token only for installs.
@casadega-development:registry=https://npm.pkg.github.com

# This reviewed, exact private tooling dependency is maintained alongside this
# repository. Exempt only that package; transitive and third-party dependencies
# retain the cooldown above (npm 11.19's min-release-age-exclude contract).
min-release-age-exclude[]=@casadega-development/ts-repo-tooling
