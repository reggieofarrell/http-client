{
  // Inherit strict, runtime-independent TypeScript safeguards plus the
  // bundler-oriented module-resolution defaults maintained by shared tooling.
  "extends": "@casadega-development/ts-repo-tooling/tsconfig/bundler.json",
  "compilerOptions": {
    // Publish ES2020 syntax so existing Node and browser consumers retain the
    // runtime floor supported by the current package major.
    "target": "ES2020",
    // Type against ES2022 standard APIs without introducing browser globals
    // into the universal library entrypoint.
    "lib": ["ES2022"],
    // Preserve ESM for the primary build; tsconfig-cjs.json owns the companion
    // CommonJS output.
    "module": "ES2020",
    // Keep emitted entrypoints directly under dist/esm rather than nesting the
    // authored src directory.
    "rootDir": "./src",
    // Emit declarations consumed by both package export conditions.
    "declaration": true,
    // Write the primary module build to its package-exported directory.
    "outDir": "./dist/esm",
    // Let the compiler reject unused authored declarations before publication.
    "noUnusedLocals": true,
    // Let the compiler reject unused public and internal parameters.
    "noUnusedParameters": true,
    // Dependency declarations are validated separately by package tests; avoid
    // allowing their internal implementation details to block this build.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
