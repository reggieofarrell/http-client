{
  "name": "@reggieofarrell/http-client",
  "version": "3.0.5",
  "packageManager": "npm@11.19.0",
  "description": "A lightweight HTTP client for both the server and browser built on `xior` with retry functionality, written in TypeScript",
  "author": "Reggie O'Farrell",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/reggieofarrell/http-client.git"
  },
  "bugs": {
    "url": "https://github.com/reggieofarrell/http-client/issues"
  },
  "keywords": [
    "http",
    "retry",
    "xior",
    "axios",
    "fetch",
    "client",
    "typescript"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./upload-progress": {
      "browser": {
        "import": "./dist/esm/upload-progress.browser.js",
        "require": "./dist/cjs/upload-progress.browser.js",
        "types": "./dist/upload-progress.browser.d.ts"
      },
      "import": "./dist/esm/upload-progress.js",
      "require": "./dist/cjs/upload-progress.js",
      "types": "./dist/upload-progress.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "license.txt"
  ],
  "scripts": {
    "prepare": "husky",
    "prepack": "node scripts/stage-npm-readme.mjs stage",
    "postpack": "node scripts/stage-npm-readme.mjs restore",
    "pre-commit": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && node scripts/finalize-esm-build.mjs && rollup -c",
    "check:build": "node scripts/check-build-output.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "check:hooks": "node scripts/check-hook-permissions.mjs",
    "test:hook-permissions": "node --test scripts/check-hook-permissions.test.mjs",
    "test:readme-lifecycle": "node --test scripts/stage-npm-readme.test.mjs",
    "start": "tsc --watch",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "packages:check": "casadega-repo-tooling packages check",
    "sonar:check": "casadega-repo-tooling sonar check",
    "sonar:findings": "casadega-repo-tooling sonar findings",
    "sonar:precheck": "casadega-repo-tooling sonar precheck",
    "sonar:rules": "casadega-repo-tooling sonar rules sync",
    "sonar:rules:check": "casadega-repo-tooling sonar rules sync --check",
    "check:format": "prettier --check .",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "rules:install": "rulesync install --frozen",
    "rules:sync": "rulesync install --update && rulesync generate",
    "rules:check": "rulesync generate --check",
    "release:bump": "commit-and-tag-version --skip.tag",
    "release:bump:dry": "commit-and-tag-version --dry-run --skip.tag",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "release:publish": "gh release create v$npm_package_version --target main --title v$npm_package_version --generate-notes",
    "release:verify": "npm run check:format && npm run lint && npm run sonar:check && npm run packages:check && npm run rules:check && npm run check:hooks && npm run test:hook-permissions && npm run test:readme-lifecycle && npm run test:types && npm test -- --coverage && npm run build && npm run check:build && npm --prefix website ci && npm run docs:build && npm run check:package && npm run check:audit",
    "format": "prettier --write .",
    "linkMe": "npm link",
    "unlinkMe": "npm unlink -g && npm i"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@casadega-development/ts-repo-tooling": "0.7.0",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.39.5",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "commit-and-tag-version": "12.6.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "16.2.4",
    "prettier": "3.9.6",
    "rollup": "4.52.4",
    "rollup-plugin-dts": "6.2.3",
    "rulesync": "16.17.0",
    "ts-jest": "29.2.5",
    "tsup": "7.2.0",
    "typescript": "5.9.3",
    "undici": "7.29.0"
  },
  "dependencies": {
    "xior": "0.8.4"
  },
  "homepage": "https://reggieofarrell.github.io/http-client/"
}
