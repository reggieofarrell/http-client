{
  "name": "@reggieofarrell/http-client",
  "version": "3.0.5",
  "description": "A lightweight HTTP client for both the server and browser built on `xior` with retry functionality, written in TypeScript",
  "author": "Reggie O'Farrell",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/reggieofarrell/http-client.git"
  },
  "bugs": {
    "url": "https://github.com/reggieofarrell/http-client/issues"
  },
  "keywords": [
    "http",
    "retry",
    "xior",
    "axios",
    "fetch",
    "client",
    "typescript"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./upload-progress": {
      "browser": {
        "import": "./dist/esm/upload-progress.browser.js",
        "require": "./dist/cjs/upload-progress.browser.js",
        "types": "./dist/upload-progress.browser.d.ts"
      },
      "import": "./dist/esm/upload-progress.js",
      "require": "./dist/cjs/upload-progress.js",
      "types": "./dist/upload-progress.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "license.txt"
  ],
  "scripts": {
    "prepare": "husky",
    "prepack": "node scripts/stage-npm-readme.mjs stage",
    "postpack": "node scripts/stage-npm-readme.mjs restore",
    "pre-commit": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && node scripts/finalize-esm-build.mjs && rollup -c",
    "check:build": "node scripts/check-build-output.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "check:hooks": "node scripts/check-hook-permissions.mjs",
    "test:hook-permissions": "node --test scripts/check-hook-permissions.test.mjs",
    "test:readme-lifecycle": "node --test scripts/stage-npm-readme.test.mjs",
    "start": "tsc --watch",
    "test": "jest",
    "test:types": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' --ignore-pattern '**/*.test.ts' --ignore-pattern '**/*.spec.ts'",
    "sonar:precheck": "node scripts/sonar-precheck.mjs",
    "sonar:rules": "node scripts/sonar-rules/sync.mjs",
    "sonar:rules:check": "node scripts/sonar-rules/sync.mjs --check",
    "test:sonar-rules": "node --test scripts/sonar-rules-sync.test.mjs",
    "check:format": "prettier --check .",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "rules:sync": "rulesync generate",
    "rules:check": "rulesync generate --check",
    "release:bump": "commit-and-tag-version --skip.tag",
    "release:bump:dry": "commit-and-tag-version --dry-run --skip.tag",
    "release:publish": "gh release create v$npm_package_version --target main --title v$npm_package_version --generate-notes",
    "release:verify": "npm run check:format && npm run lint && npm run rules:check && npm run check:hooks && npm run test:hook-permissions && npm run test:readme-lifecycle && npm run test:sonar-rules && npm run test:types && npm test -- --coverage && npm run build && npm run check:build && npm run check:package && npm run check:audit",
    "format": "prettier --write .",
    "linkMe": "npm link",
    "unlinkMe": "npm unlink -g && npm i"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "commit-and-tag-version": "^12.6.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "rollup": "^4.19.2",
    "rollup-plugin-dts": "^6.1.1",
    "rulesync": "^16.17.0",
    "ts-jest": "^29.1.1",
    "tsup": "^7.1.0",
    "typescript": "^5.9.3",
    "undici": "^7.29.0"
  },
  "dependencies": {
    "xior": "^0.8.4"
  },
  "homepage": "https://github.com/reggieofarrell/http-client#readme"
}
